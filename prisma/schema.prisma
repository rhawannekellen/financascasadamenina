generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { ADMIN TREASURER VIEWER }
enum MemberStatus { ACTIVE INACTIVE }
enum FeeStatus { PAID PENDING OVERDUE EXEMPT }
enum PaymentMethod { PIX CASH TRANSFER OTHER }
enum NotificationStatus { DRAFT SENT FAILED }

model User { id String @id @default(cuid()) name String email String @unique passwordHash String role UserRole @default(VIEWER) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt auditLogs AuditLog[] }
model HouseSettings { id String @id @default(cuid()) name String @default("Casa de Dama da Noite") monthlyAmount Decimal @db.Decimal(10, 2) defaultDueDay Int @default(10) adminContact String? reminderDaysBefore Int @default(3) reminderOnDueDate Boolean @default(true) reminderAfterDays Int[] @default([1, 5, 10]) updatedAt DateTime @updatedAt }
model Member { id String @id @default(cuid()) fullName String phone String email String? joinedAt DateTime role String? monthlyAmount Decimal @db.Decimal(10, 2) dueDay Int status MemberStatus @default(ACTIVE) payerName String? payerPhone String? fees MonthlyFee[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model MonthlyFee { id String @id @default(cuid()) memberId String member Member @relation(fields: [memberId], references: [id], onDelete: Restrict) referenceMonth DateTime amount Decimal @db.Decimal(10, 2) dueDate DateTime paidAt DateTime? paymentMethod PaymentMethod? status FeeStatus @default(PENDING) notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([memberId, referenceMonth]) @@index([status, dueDate]) @@index([referenceMonth]) }
model Notification { id String @id @default(cuid()) memberId String feeId String? recipient String message String scheduledFor DateTime? sentAt DateTime? status NotificationStatus @default(DRAFT) channel String @default("WHATSAPP_MANUAL") createdAt DateTime @default(now()) @@index([memberId, createdAt]) }
model AuditLog { id String @id @default(cuid()) userId String? user User? @relation(fields: [userId], references: [id], onDelete: SetNull) entity String entityId String action String beforeData Json? afterData Json? createdAt DateTime @default(now()) @@index([entity, entityId, createdAt]) }
